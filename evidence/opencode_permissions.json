{
  "version": "2.0.16",
  "model": "opencode/deepseek-v4.1-flash-free",
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "glob",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "grep",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": "paper/*",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "data/raw/*",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "checks/*",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "ontology.yaml",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "AGENTS.md",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "opencode.jsonc",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": ".git/*",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "evidence/*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.env",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.env.*",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "*.env",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "*.env.*",
      "effect": "deny"
    },
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "python checks/check.py *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git status *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git diff *",
      "effect": "allow"
    },
    {
      "action": "subagent",
      "resource": "*",
      "effect": "deny"
    }
  ]
}