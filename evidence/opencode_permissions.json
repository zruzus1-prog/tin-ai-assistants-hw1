{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/deepseek-v4.1-flash-free",
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "glob",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "grep",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": "paper/*",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "data/raw/*",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "checks/*",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "ontology.yaml",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "AGENTS.md",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "opencode.jsonc",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": ".git/*",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "evidence/*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.env",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.env.*",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "*.env",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "*.env.*",
      "effect": "deny"
    },
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "python checks/check.py *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git status *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git diff *",
      "effect": "allow"
    },
    {
      "action": "subagent",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "research_openalex_*",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "research_wikidata_*",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": "student_review.json",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "src/apply_student_review.py",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "REVIEW.html",
      "effect": "deny"
    }
  ],
  "mcp": {
    "servers": {
      "research": {
        "type": "local",
        "command": [
          "python",
          "src/run_research_mcp.py"
        ],
        "environment": {
          "OPENALEX_API_KEY": "{env:OPENALEX_API_KEY}"
        },
        "codemode": false,
        "timeout": {
          "execution": 120000
        }
      }
    }
  }
}